[Unit]
Description=Number Guess Game - Spring Boot API
After=network.target docker.service
Requires=docker.service

[Service]
Type=forking
User=ubuntu
WorkingDirectory=/home/ubuntu/app

# Ladda env-variabler från .env
EnvironmentFile=/home/ubuntu/app/.env

# Sätt prod-profil
Environment=SPRING_PROFILES_ACTIVE=prod

# Starta script
ExecStart=/bin/bash /home/ubuntu/app/ec2-start.sh

# PID-fil för att systemd ska kunna stoppa processen
PIDFile=/home/ubuntu/app/app.pid

# Stoppa appen
ExecStop=/bin/bash -c 'kill $(cat /home/ubuntu/app/app.pid)'

Restart=on-failure
RestartSec=15s

StandardOutput=append:/home/ubuntu/app/app.log
StandardError=append:/home/ubuntu/app/app.log

[Install]
WantedBy=multi-user.target

