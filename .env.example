# ══════════════════════════════════════════════════════
#  .env.example — Mall för miljövariabler
#  Kopiera den här filen till .env och fyll i dina värden
#  OBS: .env.example pushas till git, .env gör det INTE
# ══════════════════════════════════════════════════════

# ── Databas (Spring Boot) ──────────────────────────────
# Lokalt:  jdbc:mysql://localhost:3306/localdb?serverTimezone=UTC
# EC2:     jdbc:mysql://localhost:3306/numbergame?serverTimezone=UTC
DB_URL=jdbc:mysql://<DB_HOST>:3306/<DB_NAME>?serverTimezone=UTC
DB_USERNAME=<DB_USERNAME>
DB_PASSWORD=<DB_PASSWORD>

# ── MySQL Docker-container ─────────────────────────────
# DB_PASSWORD och MYSQL_ROOT_PASSWORD måste vara samma värde
MYSQL_ROOT_PASSWORD=<ROOT_PASSWORD>
MYSQL_DATABASE=<DB_NAME>

