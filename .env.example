# ══════════════════════════════════════════════════════
#  .env.example — Mall för miljövariabler
#  Kopiera den här filen till .env och fyll i dina värden
#  OBS: .env.example pushas till git, .env gör det INTE
# ══════════════════════════════════════════════════════

# ── Databas (Spring Boot) ──
DB_URL=jdbc:mysql://<DB_HOST>:3306/<DB_NAME>?serverTimezone=UTC
DB_USERNAME=<DB_USERNAME>
DB_PASSWORD=<DB_PASSWORD>

# ── Docker / MySQL container (lokalt) ──
MYSQL_ROOT_PASSWORD=<ROOT_PASSWORD>
MYSQL_DATABASE=<DB_NAME>

